# Copy this file to server/.env and fill it in. NEVER commit server/.env.

# --- Email (SMTP) ---
# Gmail: enable 2-Step Verification, then create an "App password"
# (Google Account > Security > App passwords) and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=lrwebtechnologies@gmail.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=lrwebtechnologies@gmail.com

# Who receives new-enquiry emails (comma separated). Add the second business
# contact's email address here so both contacts are notified.
NOTIFY_TO=lrwebtechnologies@gmail.com

# Website origin(s) allowed to call this API (comma separated).
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# Optional tuning
RATE_LIMIT_PER_HOUR=5
MIN_FILL_MS=3000
# DB_PATH=/var/data/enquiries.db
